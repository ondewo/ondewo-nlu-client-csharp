# ---------------------------------------------------------------------------------------------
# ondewo-nlu-client-csharp
#
# NOT ignored on purpose:
#   api/                            the generated stubs. Like every other ONDEWO client SDK this
#                                   repository TRACKS its generated code: `make release` stages
#                                   it, consumers read it on GitHub, and CI compiles it without
#                                   having to build the compiler image first. Uncomment the two
#                                   lines at the bottom of this file if this repository ever
#                                   switches to generate-on-checkout instead.
#   <PackageId>.csproj              the generated project file. The image reuses it from the
#                                   input volume on the next run, which is what lets this
#                                   repository customise the package.
# ---------------------------------------------------------------------------------------------

# .NET build output
bin/
obj/
artifacts/
[Dd]ebug/
[Rr]elease/
TestResults/

# NuGet - packed output and the local package cache
nupkg/
packages/
*.nupkg
*.snupkg
.nuget/
project.lock.json
project.assets.json
*.nuget.props
*.nuget.targets

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.user
*.suo
*.userprefs

# Coverage
coverage/
*.coverage
*.coveragexml
*.opencover.xml

# Generated by macOS
.DS_Store

# Generated by Windows
Thumbs.db

# Release automation - cloned at release time, never committed
ondewo-devops-accounts/

# Scratch file written by `make check_build`
build_check.txt

# Generated stubs - see the header above; only enable together with a CI job that generates them
#api/
#Ondewo.NLU.Client.csproj
